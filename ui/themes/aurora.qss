QWidget{
  background-color:#081323;
  color:#dff6ff;
  font-family:"Nunito","Segoe UI","Arial";
  font-size:11pt;
}

#title{
  font-size:18pt;
  font-weight:700;
  color:#f0fdff;
}

QLabel#cardTitle{
  font-size:12pt;
  font-weight:700;
  color:#e0f7ff;
}

QScrollArea,
QScrollArea QWidget{
  background:transparent;
}

QWidget#sidebar{
  background:rgba(2, 18, 36, 0.92);
  border-radius:14px;
}

QPushButton#sidebarButton{
  background:rgba(255, 255, 255, 0.08);
  border:none;
  border-radius:10px;
  padding:8px 12px;
  color:#dff6ff;
  text-align:left;
  min-height:32px;
}
QPushButton#sidebarButton:hover{
  background:rgba(34, 211, 238, 0.25);
}
QPushButton#sidebarButton:pressed{
  background:rgba(34, 197, 94, 0.3);
}
QPushButton#sidebarButton:checked{
  background:rgba(20, 184, 166, 0.38);
  color:#ffffff;
}

QFrame#card{
  background:rgba(255, 255, 255, 0.06);
  border:none;
  border-radius:14px;
  padding:16px;
}

QLabel{
  color:#dff6ff;
}

QPushButton{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #14b8a6,stop:1 #22d3ee);
  border:none;
  border-radius:10px;
  padding:8px 14px;
  color:#05222e;
  font-weight:700;
  min-height:30px;
}
QPushButton:hover{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #2dd4bf,stop:1 #67e8f9);
}
QPushButton:pressed{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #0d9488,stop:1 #06b6d4);
}

QLineEdit,
QSpinBox,
QComboBox{
  background:rgba(255, 255, 255, 0.1);
  border:none;
  border-radius:10px;
  padding:6px 10px;
  min-height:30px;
  color:#e6fffb;
}

QComboBox::drop-down{
  border:none;
  width:22px;
}

QCheckBox{
  spacing:8px;
}

QCheckBox::indicator{
  width:16px;
  height:16px;
  border-radius:4px;
  border:none;
  background:rgba(2, 6, 23, 0.6);
}
QCheckBox::indicator:checked{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #14b8a6,stop:1 #22d3ee);
  border:none;
}

QListWidget{
  background:rgba(255, 255, 255, 0.06);
  border:none;
  border-radius:10px;
  padding:6px;
}
QListWidget::item{
  padding:6px 8px;
  border-radius:8px;
}
QListWidget::item:selected{
  background:rgba(20, 184, 166, 0.3);
}

QProgressBar{
  border:none;
  border-radius:10px;
  background:rgba(255, 255, 255, 0.07);
  text-align:center;
  padding:2px;
}
QProgressBar::chunk{
  border-radius:8px;
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #14b8a6,stop:1 #22d3ee);
}
