/* ── Day Theme ──────────────────────────────────────────────── */
QWidget{
  background-color:qlineargradient(x1:0,y1:0,x2:0.4,y2:1,
    stop:0 #edf4fb, stop:0.5 #e8f1f9, stop:1 #e3edf6);
  color:#1e293b;
  font-family:"Poppins","Segoe UI","Arial";
  font-size:11pt;
}

#title{
  font-size:18pt;
  font-weight:700;
  color:#0f172a;
}

QLabel#cardTitle{
  font-size:12pt;
  font-weight:600;
  color:#0f172a;
}

QScrollArea,
QScrollArea QWidget{
  background:transparent;
}

QWidget#sidebar{
  background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
    stop:0 rgba(255,255,255,0.97), stop:1 rgba(241,248,255,0.93));
  border-radius:14px;
  border:1px solid rgba(148,163,184,0.22);
}

QPushButton#sidebarButton{
  background:transparent;
  border:none;
  border-radius:10px;
  padding:8px 14px;
  color:#334155;
  text-align:left;
  min-height:34px;
  font-weight:500;
}
QPushButton#sidebarButton:hover{
  background:rgba(14,165,233,0.12);
  color:#0f172a;
}
QPushButton#sidebarButton:pressed{
  background:rgba(14,165,233,0.23);
}
QPushButton#sidebarButton:checked{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 rgba(14,165,233,0.26), stop:1 rgba(34,197,94,0.18));
  color:#0f172a;
  font-weight:700;
}

QFrame#card{
  background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
    stop:0 rgba(255,255,255,0.97), stop:1 rgba(248,252,255,0.90));
  border:1px solid rgba(148,163,184,0.26);
  border-radius:16px;
  padding:18px;
}

QLabel{
  color:#1e293b;
}

QPushButton{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #0ea5e9, stop:1 #22c55e);
  border:none;
  border-radius:10px;
  padding:8px 18px;
  color:#ffffff;
  font-weight:700;
  min-height:32px;
  letter-spacing:0.2px;
}
QPushButton:hover{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #38bdf8, stop:1 #4ade80);
}
QPushButton:pressed{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #0284c7, stop:1 #16a34a);
}
QPushButton:disabled{
  background:rgba(148,163,184,0.28);
  color:rgba(30,41,59,0.38);
}

QLineEdit,
QSpinBox,
QComboBox{
  background:rgba(255,255,255,0.96);
  border:1.5px solid rgba(148,163,184,0.42);
  border-radius:10px;
  padding:6px 10px;
  min-height:30px;
  color:#0f172a;
  selection-background-color:#bae6fd;
  selection-color:#0f172a;
}
QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus{
  border:1.5px solid #0ea5e9;
  background:#ffffff;
}

QComboBox::drop-down{
  border:none;
  width:22px;
}
QComboBox QAbstractItemView{
  background:#ffffff;
  border:1px solid rgba(148,163,184,0.4);
  border-radius:10px;
  selection-background-color:#bae6fd;
  selection-color:#0f172a;
  padding:4px;
  outline:none;
}

QCheckBox{
  spacing:8px;
  color:#1e293b;
}
QCheckBox::indicator{
  width:16px;
  height:16px;
  border-radius:4px;
  border:1.5px solid rgba(100,116,139,0.55);
  background:rgba(255,255,255,0.92);
}
QCheckBox::indicator:hover{
  border-color:#0ea5e9;
}
QCheckBox::indicator:checked{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:1,
    stop:0 #0ea5e9, stop:1 #22c55e);
  border:none;
}

QListWidget{
  background:rgba(255,255,255,0.88);
  border:1px solid rgba(148,163,184,0.22);
  border-radius:10px;
  padding:6px;
  outline:none;
}
QListWidget::item{
  padding:6px 10px;
  border-radius:8px;
  color:#1e293b;
}
QListWidget::item:hover{
  background:rgba(14,165,233,0.1);
}
QListWidget::item:selected{
  background:rgba(14,165,233,0.22);
  color:#0f172a;
}

QProgressBar{
  border:none;
  border-radius:10px;
  background:rgba(148,163,184,0.22);
  text-align:center;
  padding:1px;
  font-size:9pt;
  color:#0f172a;
}
QProgressBar::chunk{
  border-radius:9px;
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #0ea5e9, stop:1 #22c55e);
}

QScrollBar:vertical{
  background:transparent;
  width:8px;
  margin:4px 2px;
}
QScrollBar::handle:vertical{
  background:rgba(100,116,139,0.4);
  border-radius:4px;
  min-height:28px;
}
QScrollBar::handle:vertical:hover{
  background:rgba(100,116,139,0.65);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{ height:0; border:none; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical{ background:none; }

QScrollBar:horizontal{
  background:transparent;
  height:8px;
  margin:2px 4px;
}
QScrollBar::handle:horizontal{
  background:rgba(100,116,139,0.4);
  border-radius:4px;
  min-width:28px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal{ width:0; border:none; }

QToolTip{
  background:#1e293b;
  color:#f8fafc;
  border:none;
  border-radius:7px;
  padding:4px 10px;
  font-size:10pt;
  opacity:230;
}
