/* ── Night Theme ──────────────────────────────────────────── */
QWidget{
  background-color:qlineargradient(x1:0,y1:0,x2:0.4,y2:1,
    stop:0 #0c1425, stop:0.5 #0b1220, stop:1 #081019);
  color:#e0e8f2;
  font-family:"Poppins","Segoe UI","Arial";
  font-size:11pt;
}

#title{
  font-size:18pt;
  font-weight:700;
  color:#f8fafc;
}

QLabel#cardTitle{
  font-size:12pt;
  font-weight:600;
  color:#f1f5f9;
}

QScrollArea,
QScrollArea QWidget{
  background:transparent;
}

QWidget#sidebar{
  background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
    stop:0 rgba(10,15,32,0.96), stop:1 rgba(8,12,25,0.93));
  border-radius:14px;
  border:1px solid rgba(96,165,250,0.12);
}

QPushButton#sidebarButton{
  background:transparent;
  border:none;
  border-radius:10px;
  padding:8px 14px;
  color:#94a3b8;
  text-align:left;
  min-height:34px;
  font-weight:500;
}
QPushButton#sidebarButton:hover{
  background:rgba(96,165,250,0.15);
  color:#e2e8f0;
}
QPushButton#sidebarButton:pressed{
  background:rgba(59,130,246,0.25);
}
QPushButton#sidebarButton:checked{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 rgba(56,189,248,0.35), stop:1 rgba(34,197,94,0.22));
  color:#ffffff;
  font-weight:700;
}

QFrame#card{
  background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
    stop:0 rgba(255,255,255,0.07), stop:1 rgba(255,255,255,0.04));
  border:1px solid rgba(96,165,250,0.11);
  border-radius:16px;
  padding:18px;
}

QLabel{
  color:#cbd5e1;
}

QPushButton{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #38bdf8, stop:1 #22c55e);
  border:none;
  border-radius:10px;
  padding:8px 18px;
  color:#0b1020;
  font-weight:700;
  min-height:32px;
  letter-spacing:0.2px;
}
QPushButton:hover{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #7dd3fc, stop:1 #4ade80);
}
QPushButton:pressed{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #0ea5e9, stop:1 #16a34a);
}
QPushButton:disabled{
  background:rgba(255,255,255,0.08);
  color:rgba(226,232,240,0.3);
}

QLineEdit,
QSpinBox,
QComboBox{
  background:rgba(255,255,255,0.07);
  border:1.5px solid rgba(96,165,250,0.22);
  border-radius:10px;
  padding:6px 10px;
  min-height:30px;
  color:#e2e8f0;
  selection-background-color:rgba(56,189,248,0.35);
  selection-color:#f8fafc;
}
QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus{
  border:1.5px solid #38bdf8;
  background:rgba(255,255,255,0.10);
}

QComboBox::drop-down{
  border:none;
  width:22px;
}
QComboBox QAbstractItemView{
  background:#0d1628;
  border:1px solid rgba(96,165,250,0.25);
  border-radius:10px;
  selection-background-color:rgba(56,189,248,0.28);
  selection-color:#f8fafc;
  padding:4px;
  outline:none;
}

QCheckBox{
  spacing:8px;
  color:#cbd5e1;
}
QCheckBox::indicator{
  width:16px;
  height:16px;
  border-radius:4px;
  border:1.5px solid rgba(96,165,250,0.35);
  background:rgba(2,6,23,0.55);
}
QCheckBox::indicator:hover{
  border-color:#38bdf8;
}
QCheckBox::indicator:checked{
  background:qlineargradient(x1:0,y1:0,x2:1,y2:1,
    stop:0 #22d3ee, stop:1 #3b82f6);
  border:none;
}

QListWidget{
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(96,165,250,0.1);
  border-radius:10px;
  padding:6px;
  outline:none;
}
QListWidget::item{
  padding:6px 10px;
  border-radius:8px;
  color:#cbd5e1;
}
QListWidget::item:hover{
  background:rgba(56,189,248,0.1);
}
QListWidget::item:selected{
  background:rgba(56,189,248,0.22);
  color:#f8fafc;
}

QProgressBar{
  border:none;
  border-radius:10px;
  background:rgba(255,255,255,0.07);
  text-align:center;
  padding:1px;
  font-size:9pt;
  color:#94a3b8;
}
QProgressBar::chunk{
  border-radius:9px;
  background:qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #22d3ee, stop:1 #3b82f6);
}

QScrollBar:vertical{
  background:transparent;
  width:8px;
  margin:4px 2px;
}
QScrollBar::handle:vertical{
  background:rgba(148,163,184,0.35);
  border-radius:4px;
  min-height:28px;
}
QScrollBar::handle:vertical:hover{
  background:rgba(148,163,184,0.55);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{ height:0; border:none; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical{ background:none; }

QScrollBar:horizontal{
  background:transparent;
  height:8px;
  margin:2px 4px;
}
QScrollBar::handle:horizontal{
  background:rgba(148,163,184,0.35);
  border-radius:4px;
  min-width:28px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal{ width:0; border:none; }

QToolTip{
  background:#0f172a;
  color:#f8fafc;
  border:1px solid rgba(96,165,250,0.22);
  border-radius:7px;
  padding:4px 10px;
  font-size:10pt;
  opacity:230;
}
