QWidget{
  background-color:#0f1115;
  color:#e5e7eb;
  font-family:"JetBrains Mono","Consolas","Courier New";
  font-size:10.5pt;
}

#title{
  font-size:17pt;
  font-weight:700;
  color:#f3f4f6;
}

QLabel#cardTitle{
  font-size:11.5pt;
  font-weight:700;
  color:#f9fafb;
}

QScrollArea,
QScrollArea QWidget{
  background:transparent;
}

QWidget#sidebar{
  background:rgba(24, 24, 27, 0.92);
  border-radius:14px;
}

QPushButton#sidebarButton{
  background:rgba(255, 255, 255, 0.06);
  border:none;
  border-radius:8px;
  padding:8px 12px;
  color:#e5e7eb;
  text-align:left;
  min-height:32px;
}
QPushButton#sidebarButton:hover{
  background:rgba(107, 114, 128, 0.34);
}
QPushButton#sidebarButton:pressed{
  background:rgba(75, 85, 99, 0.5);
}
QPushButton#sidebarButton:checked{
  background:rgba(156, 163, 175, 0.34);
  color:#ffffff;
}

QFrame#card{
  background:rgba(39, 39, 42, 0.68);
  border:none;
  border-radius:12px;
  padding:16px;
}

QLabel{
  color:#e5e7eb;
}

QPushButton{
  background:#9ca3af;
  border:none;
  border-radius:8px;
  padding:8px 14px;
  color:#111827;
  font-weight:700;
  min-height:30px;
}
QPushButton:hover{
  background:#d1d5db;
}
QPushButton:pressed{
  background:#6b7280;
}

QLineEdit,
QSpinBox,
QComboBox{
  background:rgba(63, 63, 70, 0.9);
  border:none;
  border-radius:8px;
  padding:6px 10px;
  min-height:30px;
  color:#f9fafb;
}

QComboBox::drop-down{
  border:none;
  width:22px;
}

QCheckBox{
  spacing:8px;
}

QCheckBox::indicator{
  width:16px;
  height:16px;
  border-radius:3px;
  border:none;
  background:rgba(82, 82, 91, 0.85);
}
QCheckBox::indicator:checked{
  background:#d1d5db;
  border:none;
}

QListWidget{
  background:rgba(39, 39, 42, 0.78);
  border:none;
  border-radius:10px;
  padding:6px;
}
QListWidget::item{
  padding:6px 8px;
  border-radius:6px;
}
QListWidget::item:selected{
  background:rgba(156, 163, 175, 0.35);
}

QProgressBar{
  border:none;
  border-radius:8px;
  background:rgba(63, 63, 70, 0.9);
  text-align:center;
  padding:2px;
}
QProgressBar::chunk{
  border-radius:6px;
  background:#d1d5db;
}
