QWidget{
	background:qradialgradient(
		cx:0.2, cy:0.1, radius:1.1,
		stop:0 #151f36, stop:0.4 #0f172a, stop:0.75 #0b1221, stop:1 #0a101d
	);
	color:#e0e8f2;
	font-family:"Poppins","Segoe UI","Arial";
	font-size:13px;
}

#title{
	font-size:24px;
	font-weight:600;
	color:#f8fafc;
}

QFrame#card{
	background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
		stop:0 rgba(15,23,42,0.68), stop:1 rgba(12,18,35,0.56));
	border:1px solid rgba(96,165,250,0.11);
	border-radius:16px;
	padding:18px;
}

QLabel{
	color:#e2e8f0;
}

QPushButton{
	background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #2563eb,stop:1 #60a5fa);
	border:none;
	border-radius:10px;
	padding:8px 18px;
	color:#f8fafc;
	font-weight:700;
	min-height:32px;
	letter-spacing:0.2px;
}
QPushButton:hover{
	background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #3b82f6,stop:1 #7dd3fc);
}
QPushButton:pressed{
	background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #1d4ed8,stop:1 #38bdf8);
}
QPushButton:disabled{
	background:rgba(255,255,255,0.08);
	color:rgba(226,232,240,0.3);
}

QLineEdit,
QSpinBox,
QComboBox{
	background:rgba(2, 6, 23, 0.55);
	border:1.5px solid rgba(96,165,250,0.2);
	border-radius:10px;
	padding:6px 10px;
	min-height:30px;
	color:#e2e8f0;
	selection-background-color:rgba(59,130,246,0.4);
	selection-color:#f8fafc;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus{
	border:1.5px solid #3b82f6;
	background:rgba(2,6,23,0.7);
}

QCheckBox{
	spacing:8px;
	color:#cbd5e1;
}

QCheckBox::indicator{
	width:16px;
	height:16px;
	border-radius:4px;
	border:1.5px solid rgba(96,165,250,0.3);
	background:rgba(2, 6, 23, 0.55);
}
QCheckBox::indicator:hover{
	border-color:#3b82f6;
}
QCheckBox::indicator:checked{
	background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #22d3ee,stop:1 #3b82f6);
	border:none;
}

QListWidget{
	background:rgba(2, 6, 23, 0.45);
	border:1px solid rgba(96,165,250,0.1);
	border-radius:10px;
	padding:6px;
	outline:none;
}
QListWidget::item{
	padding:6px 10px;
	border-radius:8px;
	color:#cbd5e1;
}
QListWidget::item:hover{
	background:rgba(59,130,246,0.14);
}
QListWidget::item:selected{
	background:rgba(59,130,246,0.26);
	color:#f8fafc;
}

QProgressBar{
	border:none;
	border-radius:10px;
	background:rgba(2, 6, 23, 0.4);
	text-align:center;
	padding:1px;
	font-size:9pt;
	color:#94a3b8;
}
QProgressBar::chunk{
	border-radius:9px;
	background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #22d3ee,stop:1 #3b82f6);
}

QScrollBar:vertical{
	background:transparent;
	width:8px;
	margin:4px 2px;
}
QScrollBar::handle:vertical{
	background:rgba(148, 163, 184, 0.4);
	border-radius:4px;
	min-height:28px;
}
QScrollBar::handle:vertical:hover{
	background:rgba(148,163,184,0.62);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{ height:0; border:none; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical{ background:none; }

QScrollBar:horizontal{
	background:transparent;
	height:8px;
	margin:2px 4px;
}
QScrollBar::handle:horizontal{
	background:rgba(148,163,184,0.4);
	border-radius:4px;
	min-width:28px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal{ width:0; border:none; }

QToolTip{
	background:#0f172a;
	color:#f8fafc;
	border:1px solid rgba(96,165,250,0.2);
	border-radius:7px;
	padding:4px 10px;
	font-size:10pt;
	opacity:230;
}